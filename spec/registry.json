{
  "schema_version": "4.0.0",
  "layer": "registry",
  "project": {
    "name": "智能卖家后台",
    "version": "1.0",
    "generated_at": "2026-10-03",
    "positioning": "平台级卖家经营后台。横向能力（参数/证据/门禁/核算/审计/校准）与业务模块分离；平台 × 市场 × 履约模式 为可组合的正交维度；无货源只是一种履约模式。",
    "principle": "不变的能力上提为平台级，会变的模式下沉为插件",
    "supersedes": "spec/manual-core.json (v3.0)",
    "load_order": [
      "registry.json",
      "entities.json",
      "governance.json",
      "params/platform.shopee.json",
      "params/market.tw.json",
      "params/market.th.json",
      "params/market.my.json",
      "params/assumptions.json",
      "rules/platform.json",
      "rules/modes/dropship.json",
      "modes/dropship.json",
      "modes/stock.json",
      "modes/platform_managed.json",
      "evidence/verification-tasks.json"
    ]
  },
  "evidence_levels": [
    { "level": "A", "name": "官方硬规则", "gate_eligible": true, "hard_block_allowed": true, "requires": ["source.url", "source.checked_at", "snapshot_ref"], "note": "无快照的 A 级视为无证据" },
    { "level": "B", "name": "卖家后台实测", "gate_eligible": true, "hard_block_allowed": true, "requires": ["source.url", "source.checked_at"] },
    { "level": "C", "name": "自己实测数据", "gate_eligible": true, "hard_block_allowed": true, "requires": [] },
    { "level": "D", "name": "经验启发", "gate_eligible": false, "hard_block_allowed": false, "usage": "只能 WARN / AUTO_FILL" },
    { "level": "E", "name": "待验证", "gate_eligible": false, "hard_block_allowed": false, "usage": "value 必须为 null；未核实数值放 unverified_claim；只能生成任务或 advisory 提示" }
  ],
  "gate_levels": [
    { "id": "hard", "name": "硬门禁", "behavior": "阻止操作", "requires_evidence": ["A", "B", "C"] },
    { "id": "soft", "name": "软门禁", "behavior": "允许但需确认留痕", "requires_evidence": ["A", "B", "C", "D"] },
    { "id": "advisory", "name": "建议", "behavior": "仅提示", "requires_evidence": ["A", "B", "C", "D", "E"] }
  ],
  "result_states": [
    { "id": "PASS", "meaning": "通过" },
    { "id": "INCOMPLETE", "meaning": "缺数据，无法判定；不等于不可做" },
    { "id": "WARN", "meaning": "可继续但有风险，需留痕" },
    { "id": "REJECT", "meaning": "不通过，阻止继续" }
  ],
  "value_states": [
    { "id": "null", "meaning": "未填/未知", "engine": "计入 missing_fields，结果 INCOMPLETE" },
    { "id": "zero", "meaning": "明确为零", "engine": "正常参与计算" },
    { "id": "na", "meaning": "不适用", "engine": "按 0 计算并标注 N/A" }
  ],
  "orthogonal_dimensions": ["platform", "market", "fulfillment_mode", "shop"],
  "platform_capabilities": [
    { "id": "ParamRegistry", "name": "参数注册表", "file_glob": "params/*.json", "desc": "参数唯一来源；按 scope 寻址；value=null 表示未核实" },
    { "id": "EvidenceCenter", "name": "证据中心", "file_glob": "evidence/*.json", "desc": "证据等级、来源、快照、复核日历、核实任务" },
    { "id": "GateService", "name": "门禁服务", "file_glob": "rules/*.json", "desc": "统一 check()，返回 {rule_id,result,evidence_level,next_action}" },
    { "id": "CostEngine", "name": "核算引擎", "desc": "纯函数；费率包按 platform × market 插件化" },
    { "id": "AuditLog", "name": "审计留痕", "desc": "只增不改" },
    { "id": "KpiCalibrator", "name": "KPI 校准器", "file_glob": "governance.json#kpis", "desc": "估算 → 实测 → 阈值更新" }
  ],
